{
  "id": "./",
  "name": "Streamlink Studio",
  "short_name": "Studio",
  "description": "Monitor and record live streams with streamlink and ffmpeg.",
  "start_url": "./#/channels",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0f111a",
  "theme_color": "#0f111a",
  "categories": ["utilities", "productivity"],
  "icons": [
    { "src": "pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "pwa/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "pwa/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Channels", "url": "./#/channels", "icons": [{ "src": "pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Recordings", "url": "./#/recordings", "icons": [{ "src": "pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Notifications", "url": "./#/notifications", "icons": [{ "src": "pwa/icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ]
}
