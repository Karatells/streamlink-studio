            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      }
    },
