    {
      "id": 14,
      "type": "timeseries",
      "title": "Recordings finished (per hour)",
      "description": "Counters reset when Studio restarts; increase() handles that.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (result) (increase(streamlink_studio_recordings_finished_total[1h]))",
          "legendFormat": "{{result}}",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "options": {
